{
  "name": "blitterbox",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "blitterbox": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "public",
    "tokens.json",
    "examples"
  ],
  "scripts": {
    "build": "tsc && node scripts/fix-esm-imports.mjs",
    "prepack": "npm run build",
    "check:tokens": "tsx src/tokens/check.ts",
    "check:iso": "tsx src/iso/check.ts",
    "render:primitives-check": "tsx src/primitives/renderCheck.ts",
    "check:motion": "tsx src/motion/check.ts",
    "check:scene": "tsx src/scene/check.ts",
    "render:social-card-check": "tsx src/compositions/renderCheck.ts",
    "generate:logo-blocks": "tsx src/compositions/generateLogoBlocks.ts",
    "render:logo-clip-frames": "tsx src/compositions/renderLogoClipFrames.ts",
    "mcp:server": "tsx src/mcp/server.ts",
    "mcp:check": "tsx src/mcp/check.ts",
    "render:tower": "tsx src/compositions/renderTower.ts",
    "render:logo-clip": "tsx src/compositions/renderLogoClipVideo.ts",
    "swap-test": "tsx src/swapTest.ts",
    "check:dist": "npm run build && node scripts/test-compiled-server.mjs"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.536",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/bundler": "^4.0.536",
    "@remotion/fonts": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.536",
    "zod": "^4.6.7"
  }
}
