{
  "$description": "Blitterbox brand tokens v1.0. W3C Design Tokens (DTCG) format, with custom groups for isometric faces and motion. Source: Blitterbox Brand Standards v1.0, October 2026. Values marked $extensions.blitterbox.source = \"default\" are not in the brand guide and were chosen to fit it.",

  "color": {
    "$type": "color",
    "vellum":     { "$value": "#EFEDE6", "$description": "Paper. Every background. 60% of any surface." },
    "graphite":   { "$value": "#121212", "$description": "Ink. Type and lines. 30%." },
    "chartreuse": { "$value": "#D4FF3A", "$description": "Highlight. 10%. One element per surface; never a whole page except packaging and stickers." },
    "cream":      { "$value": "#F6F4EE", "$description": "Panels, box front, scene grounds." },
    "paper":      { "$value": "#FFFFFF", "$description": "Cube tops, cards." },
    "pencil":     { "$value": "#5E5B54", "$description": "Secondary text." },
    "shade":      { "$value": "#9BC21A", "$description": "Chartreuse in shadow." }
  },

  "role": {
    "$type": "color",
    "background":     { "$value": "{color.vellum}" },
    "surface":        { "$value": "{color.cream}" },
    "card":           { "$value": "{color.paper}" },
    "ink":            { "$value": "{color.graphite}" },
    "ink-secondary":  { "$value": "{color.pencil}" },
    "highlight":      { "$value": "{color.chartreuse}" },
    "highlight-shadow": { "$value": "{color.shade}" }
  },

  "contrast": {
    "$description": "WCAG contrast ratios from the brand guide. 'never' pairs must not be used for text.",
    "graphite-on-vellum":     { "$value": 16.0, "$type": "number", "$extensions": { "blitterbox": { "use": "all text" } } },
    "graphite-on-chartreuse": { "$value": 16.2, "$type": "number", "$extensions": { "blitterbox": { "use": "all text" } } },
    "chartreuse-on-graphite": { "$value": 16.2, "$type": "number", "$extensions": { "blitterbox": { "use": "all text" } } },
    "pencil-on-vellum":       { "$value": 5.8,  "$type": "number", "$extensions": { "blitterbox": { "use": "secondary text" } } },
    "chartreuse-on-vellum":   { "$value": 1.0,  "$type": "number", "$extensions": { "blitterbox": { "use": "never" } } }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Bricolage Grotesque", "sans-serif"], "$description": "Display and body. Weights 400, 600, 800 only." },
      "mono": { "$value": ["JetBrains Mono", "monospace"], "$description": "Labels, figure numbers, callouts, code." }
    }
  },

  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 800, "fontSize": "96px", "lineHeight": 0.85, "letterSpacing": "-0.015em" } },
    "h1":      { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 800, "fontSize": "56px", "lineHeight": 0.95, "letterSpacing": "-0.01em" } },
    "h2":      { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 600, "fontSize": "32px", "lineHeight": 1.1,  "letterSpacing": "-0.005em" } },
    "body":    { "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 400, "fontSize": "18px", "lineHeight": 1.55, "letterSpacing": "0em" } },
    "label":   { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 500, "fontSize": "12px", "lineHeight": 1.3, "letterSpacing": "1px" },
                 "$description": "Uppercase. Line height is a default.", "$extensions": { "blitterbox": { "textTransform": "uppercase" } } },
    "code":    { "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 400, "fontSize": "14px", "lineHeight": 1.8, "letterSpacing": "0em" } },
    "wordmark":{ "$value": { "fontFamily": "{font.family.sans}", "fontWeight": 800, "fontSize": "1em", "lineHeight": 1, "letterSpacing": "-0.015em" },
                 "$description": "All lowercase. Never tighter than -1.5%.", "$extensions": { "blitterbox": { "textTransform": "lowercase" } } }
  },

  "iso": {
    "$description": "Isometric geometry. True isometric only: 30 degree axes, no perspective, no rotation off the grid.",
    "angle":  { "$value": 30, "$type": "number", "$description": "Degrees from horizontal for the x and y axes." },
    "module": { "$value": 40, "$type": "number", "$description": "Pixels per 1m block edge at 1x scale. Scale it with the drawing.",
                "$extensions": { "blitterbox": { "source": "default" } } },
    "stroke": {
      "width": { "$value": 1.5, "$type": "number", "$description": "Line weight in px at screen size; scale with the drawing." },
      "color": { "$value": "{color.graphite}", "$type": "color" },
      "join":  { "$value": "round", "$type": "string", "$extensions": { "blitterbox": { "source": "default" } } }
    }
  },

  "face": {
    "$type": "color",
    "$description": "The face rule. Every primitive reads these. In a customer kit, their palette replaces brand.front and brand.side; the rules stay.",
    "brand": {
      "top":   { "$value": "{color.paper}" },
      "front": { "$value": "{color.chartreuse}" },
      "side":  { "$value": "{color.graphite}" }
    },
    "neutral": {
      "$description": "Platforms and grounds use vellum tones so brand faces pop.",
      "top":   { "$value": "{color.cream}" },
      "front": { "$value": "{color.vellum}" },
      "side":  { "$value": "#DCD9D0", "$extensions": { "blitterbox": { "source": "default", "note": "Vellum darkened about 8% for the shaded face." } } }
    }
  },

  "motion": {
    "$description": "Built, not revealed. Things assemble block by block. No fades, wipes, glows, floats or bounce.",
    "drop": {
      "duration": { "$value": "120ms", "$type": "duration", "$description": "Each block falls in 120 ms." },
      "easing":   { "$value": [0.2, 0.9, 0.3, 1], "$type": "cubicBezier", "$description": "Firm ease-out, no overshoot.",
                    "$extensions": { "blitterbox": { "source": "default", "note": "Guide says firm ease-out, no bounce; exact curve chosen." } } },
      "distance": { "$value": 1, "$type": "number", "$description": "Drop height in modules.", "$extensions": { "blitterbox": { "source": "default" } } },
      "stagger":  { "$value": "60ms", "$type": "duration", "$description": "Gap between consecutive blocks.", "$extensions": { "blitterbox": { "source": "default" } } }
    },
    "callout": {
      "mode":     { "$value": "type-in", "$type": "string", "$description": "Labels type in, in mono, character by character, after the object lands." },
      "perChar":  { "$value": "30ms", "$type": "duration", "$extensions": { "blitterbox": { "source": "default" } } },
      "delay":    { "$value": "80ms", "$type": "duration", "$description": "Wait after the object lands.", "$extensions": { "blitterbox": { "source": "default" } } }
    },
    "logo": {
      "$description": "The logo assembles in 1.2 s.",
      "base":   { "$value": "0ms",    "$type": "duration" },
      "sides":  { "$value": "360ms",  "$type": "duration" },
      "locked": { "$value": "840ms",  "$type": "duration" },
      "name":   { "$value": "1200ms", "$type": "duration" }
    },
    "forbidden": { "$value": ["fade", "wipe", "glow", "float", "bounce", "overshoot"], "$type": "string" }
  },

  "logo": {
    "$description": "Eight 1m blocks on a 30 degree isometric grid.",
    "blocks":       { "$value": 8, "$type": "number" },
    "clearSpace":   { "$value": 1, "$type": "number", "$description": "In modules (one block width) on every side." },
    "minLockup":    { "$value": "96px", "$type": "dimension" },
    "minMark":      { "$value": "24px", "$type": "dimension", "$description": "Below 24 px use the flat favicon." }
  },

  "ui": {
    "radius":       { "$value": "0px", "$type": "dimension", "$description": "Square corners." },
    "borderWidth":  { "$value": "1px", "$type": "dimension" },
    "borderColor":  { "$value": "{color.graphite}", "$type": "color" },
    "primaryButton":{ "$value": "{color.chartreuse}", "$type": "color", "$description": "Once per screen. Arrow on forward actions." }
  }
}
